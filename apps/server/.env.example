# ─── App / Runtime ───────────────────────────────────────────────
# Render sets PORT automatically; Bun's runtime reads it and binds
# to it. No need to edit — shown here for completeness.
PORT=3000

# Must be "production" so rate limiting, secure cookies, and
# sameSite=none all flip on. Render sets NODE_ENV=production, but set
# it explicitly in the dashboard to be safe.
NODE_ENV=production

# ─── Auth ───────────────────────────────────────────────────────
# min 32 chars — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
# Public HTTPS base URL of the API. CRITICAL for passkeys/WebAuthn —
# the Relying Party ID is derived from this hostname, so it must be
# your real deployed domain (not localhost).
BETTER_AUTH_URL=https://your-app.onrender.com
# Browser origin(s) allowed by CORS (your web app's URL). Native apps
# ignore CORS but this is also added to auth trustedOrigins.
CORS_ORIGIN=https://your-web-origin.example.com

# ─── Database (use Render's managed Postgres) ───────────────────
# Internal connection string from the Render Postgres dashboard
# ("psql" / Internal Database URL). Replace localhost:5433 with the
# Render host/port, user, password, and db name.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-RENDER-REGION.onrender.com:5432/kosh

# ─── Email (Resend REST API in production) ─────────────────────────
# Production uses Resend's REST API over HTTPS (port 443) because
# Render's FREE web services block outbound SMTP ports (25/465/587).
# API key from https://resend.com/api-keys (looks like re_...).
RESEND_API_KEY=re_xxxx_xxxxxxxxxxxxxxxxxxxxxxxx
# From address MUST be a domain verified in Resend (Dashboard > Domains),
# or use onramp@resend.dev for quick tests. Bare email only — the app
# wraps it as "Kosh App <...>".
EMAIL_FROM=noreply@yourdomain.com

# SMTP is only used when RESEND_API_KEY is NOT set (local dev → Mailpit
# via docker-compose, web UI at http://localhost:8025). Not used in
# production.
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ─── Redis ──────────────────────────────────────────────────────
# The kosh-redis container is scaffolded but REDIS_URL is NOT read by
# any code yet (rate limiting is in-memory). Safe to omit; shown only
# for reference.
# REDIS_URL=redis://localhost:6380

# ─── Build/CI only ──────────────────────────────────────────────
# Set to "1" to skip env validation (useful in CI builds where env
# isn't present yet). Not needed at runtime on Render.
# SKIP_ENV_VALIDATION=1
