# ─── Auth ───────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=          # min 32 chars — generate with: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001

# ─── Database (Docker: kosh-db on port 5433) ───────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5433/kosh

# ─── Email — Mailpit SMTP (Docker: kosh-mailpit) ───────────────────
# View captured emails at: http://localhost:8026
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@kosh.local

# ─── Redis (Docker: kosh-redis on port 6380) ───────────────────────
REDIS_URL=redis://localhost:6380
