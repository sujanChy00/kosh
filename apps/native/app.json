{
  "expo": {
    "name": "Kosh",
    "slug": "kosh-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kosh-app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.kosh-app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.mybettertapp"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/mono-bold-italic.ttf",
            "./assets/fonts/mono-bold.ttf",
            "./assets/fonts/mono-medium-italic.ttf",
            "./assets/fonts/mono-medium.ttf",
            "./assets/fonts/mono-regular.ttf",
            "./assets/fonts/mono-semibold-italic.ttf",
            "./assets/fonts/mono-semibold.ttf",
            "./assets/fonts/notosans-bold.ttf",
            "./assets/fonts/notosans-italic.ttf",
            "./assets/fonts/notosans-medium.ttf",
            "./assets/fonts/notosans-regular.ttf",
            "./assets/fonts/notosans-semibold.ttf",
            "./assets/fonts/notosans-bold-italic.ttf",
            "./assets/fonts/notosans-medium-italic.ttf",
            "./assets/fonts/notosans-semibold-italic.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image",
        {
          "disableLibdav1d": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
