{
  "expo": {
    "name": "Kosh",
    "slug": "kosh-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kosh-app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.koshapp.app",
      "associatedDomains": ["webcredentials:kosh-fd5d.onrender.com"]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.koshapp.app",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.DOWNLOAD_WITHOUT_NOTIFICATION",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos for updating your profile picture and item images.",
          "cameraPermission": "The app accesses your camera for updating your profile picture and item images.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/mono-bold-italic.ttf",
            "./assets/fonts/mono-bold.ttf",
            "./assets/fonts/mono-medium-italic.ttf",
            "./assets/fonts/mono-medium.ttf",
            "./assets/fonts/mono-regular.ttf",
            "./assets/fonts/mono-semibold-italic.ttf",
            "./assets/fonts/mono-semibold.ttf",
            "./assets/fonts/notosans-bold.ttf",
            "./assets/fonts/notosans-italic.ttf",
            "./assets/fonts/notosans-medium.ttf",
            "./assets/fonts/notosans-regular.ttf",
            "./assets/fonts/notosans-semibold.ttf",
            "./assets/fonts/notosans-bold-italic.ttf",
            "./assets/fonts/notosans-medium-italic.ttf",
            "./assets/fonts/notosans-semibold-italic.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-image",
        {
          "disableLibdav1d": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "526e73b9-d895-41a2-9b8e-b665d1e47e31"
      }
    }
  }
}
