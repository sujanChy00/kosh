{
  "name": "kosh-app",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "@types/bun": "^1.4.0",
      "hono": "^4.12.32",
      "@trpc/server": "^11.18.0",
      "better-auth": "1.7.1",
      "@tanstack/react-query": "^5.101.4",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.3",
      "@trpc/tanstack-react-query": "^11.18.0",
      "@trpc/client": "^11.18.0",
      "@tanstack/react-form": "^1.33.2",
      "@types/react-dom": "^19.2.3",
      "@better-auth/expo": "1.7.1",
      "react": "19.2.3",
      "react-dom": "19.2.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native --",
    "android": "cd apps/native && expo run:android",
    "fix:install": "cd apps/native && expo install --check",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @kosh-app/db --",
    "db:studio": "turbo run db:studio -F @kosh-app/db --",
    "db:generate": "turbo run db:generate -F @kosh-app/db --",
    "db:migrate": "turbo run db:migrate -F @kosh-app/db --",
    "db:reset": "turbo run db:reset -F @kosh-app/db --",
    "clean": "bun run scripts/clean.js",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@kosh-app/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kosh-app/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.0"
}
